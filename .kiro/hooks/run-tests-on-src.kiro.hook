{
  "enabled": true,
  "name": "Run Tests on Source Changes",
  "description": "Runs unit and property tests (excluding integration tests that need Colima) whenever source files under src/ are modified, catching regressions before push.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.kt"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "./gradlew test -PexcludeTags=integration",
    "timeout": 300
  }
}