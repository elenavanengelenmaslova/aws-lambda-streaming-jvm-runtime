{
  "enabled": true,
  "name": "Validate SAM Template",
  "description": "Validates the SAM template whenever it is modified, catching syntax and schema errors before push.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "deployment/aws/sam/template.yaml"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "cd deployment/aws/sam && sam validate --template-file template.yaml --region eu-west-1",
    "timeout": 30
  }
}